@model FitnessClub_Test.Dtos.ClassDetailsDTO

@{
    ViewData["Title"] = "Class Details";
}

<head>
    <style>
        .container div, .btn {
            width: 100%;
        }

        .flex {
            display: flex;
            justify-content: space-between;
            gap: 1em;
        }

        .text-danger {
            font-size: 0.85rem;
        }
    </style>
</head>

<main>
    <div class="d-flex justify-content-between">
        <div class="container card my-4" style="width:60%;">
            <div class="card-header">
                <h2>@Model.Class.Name</h2>
            </div>

            <div class="card-body">
                <form>
                    <div class="flex">
                        <div class="form-group mb-3">
                            <label>Name</label>
                            <input asp-for="Class.Name" class="form-control" value="@Model.Class.Name" readonly />
                        </div>

                        <div class="form-group mb-3">
                            <label>Type</label>
                            <input asp-for="Class.Type" class="form-control" value="@Model.Class.Type" readonly />
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label>Description</label>
                        <textarea asp-for="Class.Description" class="form-control" readonly>@Model.Class.Description</textarea>
                    </div>

                    <div class="flex">

                        <div class="flex">
                            <div class="form-group mb-3">
                                <label>Start Date</label>
                                <input asp-for="Class.StartDate" type="datetime-local" class="form-control" value="@Model.Class.StartDate.ToString("yyyy-MM-ddTHH:mm")" readonly />
                            </div>

                            <div class="form-group mb-3">
                                <label>End Date</label>
                                <input asp-for="Class.EndDate" type="datetime-local" class="form-control" value="@Model.Class.EndDate.ToString("yyyy-MM-ddTHH:mm")" readonly />
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label>Recurrence</label>
                            <select asp-for="Class.Recurrence" class="form-control" readonly>
                                @foreach (var item in ViewBag.Recurrence)
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="flex">
                        <div class="form-group mb-3">
                            <label>Fee</label>
                            <input asp-for="Class.Fee" type="number" step="0.01" class="form-control" value="@Model.Class.Fee" readonly />
                        </div>

                        <div class="form-group mb-3">
                            <label>Max Occupancy</label>
                            <input asp-for="Class.MaxOccupancy" type="number" class="form-control" value="@Model.Class.MaxOccupancy" readonly />
                        </div>

                        <div class="form-group mb-3">
                            <label>Status</label>
                            <select asp-for="Class.Status" class="form-control" readonly>
                                <option value="">-- Select Status --</option>
                                @foreach (var status in ViewBag.Status)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>

                    </div>

                    <div class="form-group mb-3">
                        <label>Coach</label>
                        <select asp-for="Class.CoachID" class="form-control" readonly>
                            <option value="">-- Select Coach --</option>
                            @foreach (var coach in ViewBag.Coaches)
                            {
                                <option value="@coach.Id">
                                    @coach.User.FirstName @coach.User.LastName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="flex mb-3">
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createBookingModal">
                            Create A Booking
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Back</a>
                    </div>

                </form>
            </div>
        </div>
        
        
        <div class="container card w-25 my-4">
            <div class="card-header">
                <h2>Enrolled Clients</h2>
            </div>
            <div class="card-body" style="max-height: 470px; overflow-y: auto;">

                @if (Model.Clients != null && Model.Clients.Any())
                {
                    <ul class="list-group p-0">
                        @foreach (var client in Model.Clients)
                        {
                            <li class="list-group-item" style="border:0;border-bottom:1px solid grey">
                                <strong>@client.FullName</strong><br />
                                <small>@client.Email</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No clients enrolled.</p>
                }

            </div>
        </div>
    </div>
    <div class="modal fade" id="createBookingModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <form asp-controller="Class" asp-action="CreateBooking" method="post">

                    <div class="modal-header d-flex justify-content-between">
                        <h5 class="modal-title">Create Booking</h5>
                        <button type="button" class="btn-close ms-0" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                        <!-- Hidden Class ID -->
                        <input type="hidden" name="ClassID" value="@Model.Class.ClassID" />

                        <!-- Client Dropdown -->
                        <div class="mb-3">
                            <label class="form-label">Select Client</label>
                            <select name="ClientID" class="form-select" required>
                                <option value="">-- Select Client --</option>

                                @foreach (var client in Model.AllClients)
                                {
                                    <option value="@client.ClientID">
                                        @client.FullName
                                    </option>
                                }
                            </select>
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Create Booking</button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</main>

<!--  REQUIRED FOR CLIENT-SIDE VALIDATION -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}