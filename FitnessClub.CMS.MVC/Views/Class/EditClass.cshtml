@model FitnessClub_Test.Dtos.ClassDTO

@{
    ViewData["Title"] = "Edit Class";
}

<head>
    <style>
        .container div, .btn {
            width: 100%;
        }

        .flex {
            display: flex;
            justify-content: space-between;
            gap: 1em;
        }

        .text-danger {
            font-size: 0.85rem;
        }
    </style>
</head>

<main>

    <div class="container card w-75 my-4">
        <div class="card-header">
            <h2>@Model.Name</h2>
        </div>

        <div class="card-body">
            <form asp-action="Edit" asp-controller="Class" method="post">
                <input type="hidden" asp-for="@Model.ClassID" value="@Model.ClassID"/>
                <div class="flex">
                    <div class="form-group mb-3">
                        <label>Name</label>
                        <input asp-for="Name" class="form-control" value="@Model.Name"/>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label>Type</label>
                        <input asp-for="Type" class="form-control" value="@Model.Type"/>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label>Description</label>
                    <textarea asp-for="Description" class="form-control">@Model.Description</textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="flex">

                    <div class="flex">
                        <div class="form-group mb-3">
                            <label>Start Date</label>
                            <input asp-for="StartDate" type="datetime-local" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label>End Date</label>
                            <input asp-for="EndDate" type="datetime-local" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label>Recurrence</label>
                        <select asp-for="Recurrence" class="form-control">
                            @foreach (var item in ViewBag.Recurrence)
                            {
                                <option value="@item">@item</option>
                            }
                        </select>
                        <span asp-validation-for="Recurrence" class="text-danger"></span>
                    </div>
                </div>

                <div class="flex">
                    <div class="form-group mb-3">
                        <label>Fee</label>
                        <input asp-for="Fee" type="number" step="0.01" class="form-control" value="@Model.Fee" />
                        <span asp-validation-for="Fee" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label>Max Occupancy</label>
                        <input asp-for="MaxOccupancy" type="number" class="form-control" value="@Model.MaxOccupancy" />
                        <span asp-validation-for="MaxOccupancy" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label>Status</label>
                        <select asp-for="Status" class="form-control">
                            <option value="">-- Select Status --</option>
                            @foreach (var status in ViewBag.Status)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                </div>

                <div class="form-group mb-3">
                    <label>Coach</label>
                    <select asp-for="CoachID" class="form-control">
                        <option value="">-- Select Coach --</option>
                        @foreach (var coach in ViewBag.Coaches)
                        {
                            <option value="@coach.Id">
                                @coach.User.FirstName @coach.User.LastName
                            </option>
                        }
                    </select>
                    <span asp-validation-for="CoachID" class="text-danger"></span>
                </div>

                <div class="flex mb-3">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>

</main>

<!-- 🔥 REQUIRED FOR CLIENT-SIDE VALIDATION -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}