@model IEnumerable<FitnessClub_Test.Dtos.ClassDTO>
@{

}
<head>
    <style>
        .card-custom {
            float: left;
            margin-left: 1.5rem;
        }

        .a-custom {
            max-width: fit-content;
            margin-left: 1rem;
            display: none;
        }

        .clickable-row:hover {
            background-color: #f1f1f1;
        }

    </style>
</head>
<!--begin::App Main-->
<main class="app-main">
    <div class="app-content">
        <!--begin::Container-->
        <div class="container-fluid">

            <!--begin: Row -->
            <div class="row mt-4">
                <div class="col-md-12">
                    <!--begin Class View-->
                    <div class="card mb-4">
                        <form asp-controller="Class" asp-action="BulkDelete" method="post">
                            <div class="card-header">
                                <div class="card-custom">
                                    <div class="form-check d-flex">
                                        <input class="form-check-input mt-2" style="float:left" type="checkbox" id="checkAll">
                                        <a asp-controller="Class" asp-action="Create" class="btn btn-primary" style="margin-left:2rem;">Create</a>
                                        <button type="submit" class="btn btn-danger a-custom" id="delete-all-btn"><i class="bi bi-trash"></i> Delete</button>
                                    </div>
                                </div>
                                <h5 class="card-title mt-2">Class List</h5>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">
                                <!--begin::Row-->
                                <div class="row">
                                    <div class="table-responsive">
                                        <table class="table m-0">
                                            <thead>
                                                <tr>
                                                    <th style="width:5%"></th>
                                                    <th>Class ID</th>
                                                    <th>Name</th>
                                                    <th>Type</th>
                                                    <th>Start Date</th>
                                                    <th>End Date</th>
                                                    <th>Recurrence</th>
                                                    <th>Coach Name</th>
                                                    <th>Status</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model?.Any() == true)
                                                {
                                                    foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <input type="checkbox" name="selectedClassIDs"
                                                                       value="@item.ClassID"
                                                                       class="form-check-input item-checkbox"
                                                                       style="margin-left:1rem" />
                                                            </td>

                                                            <td class="clickable-row" data-href="@Url.Action("Details", "Class", new { classID = item.ClassID })" style="cursor:pointer;">@item.ClassID</td>
                                                            <td class="clickable-row" data-href="@Url.Action("Details", "Class", new { classID = item.ClassID })" style="cursor:pointer;">@item.Name</td>
                                                            <td class="clickable-row" data-href="@Url.Action("Details", "Class", new { classID = item.ClassID })" style="cursor:pointer;">@item.Type</td>
                                                            <td class="clickable-row" data-href="@Url.Action("Details", "Class", new { classID = item.ClassID })" style="cursor:pointer;">@item.StartDate</td>
                                                            <td class="clickable-row" data-href="@Url.Action("Details", "Class", new { classID = item.ClassID })" style="cursor:pointer;">@item.EndDate</td>
                                                            <td class="clickable-row" data-href="@Url.Action("Details", "Class", new { classID = item.ClassID })" style="cursor:pointer;">@item.Recurrence</td>
                                                            <td class="clickable-row" data-href="@Url.Action("Details", "Class", new { classID = item.ClassID })" style="cursor:pointer;">@item.CoachName</td>
                                                            <td class="clickable-row" data-href="@Url.Action("Details", "Class", new { classID = item.ClassID })" style="cursor:pointer;">@item.Status</td>

                                                            <td>
                                                                <div class="w-100 btn-group" role="group">
                                                                    <a asp-controller="Class" asp-action="Edit" asp-route-ClassID="@item.ClassID"
                                                                       class="btn btn-primary mx-2">
                                                                        <i class="bi bi-pencil-square"></i> Edit
                                                                    </a>

                                                                    <a href="#"
                                                                       class="btn btn-danger mx-2 delete-class-btn"
                                                                       data-class-id="@item.ClassID">
                                                                        <i class="bi bi-trash"></i> Delete Class
                                                                    </a>

                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="8" class="text-center text-muted">
                                                            No classes available
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <!-- /.table-responsive -->

                                </div>
                                <!--end::Row-->
                            </div>
                            <!-- ./card-body -->
                        </form>
                    </div>
                    <!-- end Class View -->
                </div>
            </div>
            <!--end:: Row -->
        </div>
        <!--end::Container-->

        <div class="modal fade" id="deleteClassModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header justify-content-between">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close ms-0" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        Are you sure you want to delete this class?
                    </div>

                    <div class="modal-footer">

                        <form asp-controller="Class" asp-action="Delete" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="ClassID" id="deleteClassId" />

                            <button type="submit" class="btn btn-danger">
                                Delete
                            </button>
                        </form>

                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>
    <!--end::App Content-->
</main>
<!--end::App Main-->

@* Check All checkboxes *@
<script>
    const checkAll = document.getElementById('checkAll');
    const checkboxes = document.querySelectorAll('.item-checkbox');
    const deleteButton = document.getElementById('delete-all-btn');

    function updateRowHighlight(checkbox) {
      const row = checkbox.closest('tr');
      row.classList.toggle('table-active', checkbox.checked);
    }

    function updateDeleteButton() {
      const checkedCount = document.querySelectorAll('.item-checkbox:checked').length;
      deleteButton.style.display = checkedCount >= 2 ? 'inline-block' : 'none';
    }

    // Handle individual checkbox changes
    checkboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        updateRowHighlight(cb);

        // Update "Check All" state
        const allChecked = [...checkboxes].every(c => c.checked);
        checkAll.checked = allChecked;

        updateDeleteButton();
      });
    });

    // Handle "Check All" checkbox
    checkAll?.addEventListener('change', function () {
      const isChecked = this.checked;
      checkboxes.forEach(cb => {
        cb.checked = isChecked;
        updateRowHighlight(cb);
      });
      updateDeleteButton();
    });

    document.querySelectorAll(".clickable-row").forEach(row => {
        row.addEventListener("click", function () {
            const href = this.getAttribute("data-href");
            if (href) {
                window.location.href = href;
            }
        });
    });
</script>

@* Delete Modal *@
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const deleteButtons = document.querySelectorAll(".delete-class-btn");
        const modal = new bootstrap.Modal(document.getElementById("deleteClassModal"));
        const hiddenInput = document.getElementById("deleteClassId");

        deleteButtons.forEach(btn => {
            btn.addEventListener("click", function (e) {
                e.preventDefault();

                const classId = this.getAttribute("data-class-id");

                hiddenInput.value = classId;

                modal.show();
            });
        });

    });
</script>