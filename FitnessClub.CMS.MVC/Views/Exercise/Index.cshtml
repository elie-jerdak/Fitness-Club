@using FitnessClub_Test.Dtos
@model List<ExerciseDTO>
@{
    
}
<head>
    <style>
        input {
            border: none;
            outline: none;
            background: transparent;
            
        }
    </style>
</head>
<main class="app-main">
    <div class="app-content">
        <div class="container-fluid">
            <div class="row mt-4">
                <div class="col-md-12">
                    <div class="card mb-4">
                        <form asp-controller="Exercise" asp-action="BulkDelete" method="post">
                            <div class="card-header d-flex justify-content-between">
                                <div >
                                    <div class="form-check d-flex" style="margin-left:1rem">
                                        <input class="form-check-input m-2" style="float:left" type="checkbox" id="checkAll">
                                        <button type="button" class="btn btn-primary mx-2" data-bs-toggle="modal" data-bs-target="#createExerciseModal">Create</button>
                                        <button type="submit" class="btn btn-danger a-custom" id="delete-all-btn" style="display:none"><i class="bi bi-trash"></i> Delete</button>
                                    </div>
                                </div>
                                <h5 class="card-title mt-2" style="margin-inline-start:auto">Exercises List</h5>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">
                                <!--begin::Row-->
                                <div class="row">
                                    <div class="table-responsive">
                                        <table class="table m-0">
                                            <thead>
                                                <tr>
                                                    <th style="width:5%"></th>
                                                    <th>Exercise ID</th>
                                                    <th>Name</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Any())
                                                {
                                                    @foreach (var item in Model)
                                                    {
                                                        <tr>
                                                            @* Later Create a detail view where it shows a video of the exercise and also which uscle groupe the exercise targets and other related fields *@
                                                            <td><input type="checkbox" value="@item.ExerciseID" name="selectedIds" class="form-check-input item-checkbox" style="margin-left:1rem" /></td>
                                                            <td> @*class="clickable-row"  data-href="@Url.Action("Details", "Exercise", new { ExerciseID = item.ExerciseID })"  style="cursor:pointer;"*@
                                                                <input class="text-black enable-me" type="number" name="ExerciseID" value="@item.ExerciseID" disabled />
                                                            </td>
                                                            <td> @*class="clickable-row" data-href="@Url.Action("Details", "Exercise", new { ExerciseID = item.ExerciseID })"  style="cursor:pointer;"*@
                                                                <input class="text-black  enable-me" type="text" name="Name" value="@item.Name" disabled />
                                                            </td>
                                                            <td>
                                                                <div class="w-100 btn-group" role="group">
                                                                    <button type="button" class="btn btn-primary mx-2 edit-btn">Edit Exercise</button>
                                                                    <button type="button" class="btn btn-success save-btn" style="display:none">Save</button>
                                                                    <button type="button" class="btn btn-danger delete-btn mx-2" data-id="@item.ExerciseID">
                                                                        <i class="bi bi-trash"></i> Delete Exercise
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="4" class="text-center">No exercises found.</td>
                                                    </tr>
                                                }
                                                
                                                
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </form>
                        @* Create Modal *@
                        <div class="modal fade" id="createExerciseModal" tabindex="-1" aria-labelledby="createExerciseModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header d-flex justify-content-between">
                                        <h5 class="modal-title" id="createExerciseModalLabel">Create Exercise</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="margin-right:0"></button>
                                    </div>
                                    <div class="modal-body">
                                        <form id="createExerciseForm">
                                            <div class="mb-3">
                                                <label for="exerciseName" class="form-label">Exercise Name</label>
                                                <input type="text" class="form-control" id="exerciseName" name="Name" required>
                                            </div>
                                            <div id="createExerciseError" class="text-danger" style="display:none;"></div>
                                        </form>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn btn-primary" id="saveExerciseBtn">Save</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @* Delete Modal *@
                        <div class="modal fade" id="deleteExerciseModal" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header d-flex justify-content-between">
                                        <h5 class="modal-title">Confirm Delete</h5>
                                        <button type="button" class="btn-close ms-0" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are you sure you want to delete this exercise?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                            Cancel
                                        </button>
                                        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                                            Delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@* CheckBoxes check all *@
<script>
    const checkAll = document.getElementById('checkAll');
    const checkboxes = document.querySelectorAll('.item-checkbox');
    const deleteButton = document.getElementById('delete-all-btn');

    function updateRowHighlight(checkbox) {
      const row = checkbox.closest('tr');
      row.classList.toggle('table-active', checkbox.checked);
    }

    function updateDeleteButton() {
      const checkedCount = document.querySelectorAll('.item-checkbox:checked').length;
      deleteButton.style.display = checkedCount >= 2 ? 'inline-block' : 'none';
    }

    // Handle individual checkbox changes
    checkboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        updateRowHighlight(cb);

        // Update "Check All" state
        const allChecked = [...checkboxes].every(c => c.checked);
        checkAll.checked = allChecked;

        updateDeleteButton();
      });
    });

    // Handle "Check All" checkbox
    checkAll?.addEventListener('change', function () {
      const isChecked = this.checked;
      checkboxes.forEach(cb => {
        cb.checked = isChecked;
        updateRowHighlight(cb);
      });
      updateDeleteButton();
    });

    document.querySelectorAll(".clickable-row").forEach(row => {
        row.addEventListener("click", function () {
            const href = this.getAttribute("data-href");
            if (href) {
                window.location.href = href;
            }
        });
    });
</script>

@* Save Button of Create *@
<script>
        document.getElementById("saveExerciseBtn").addEventListener("click", async function () {
        const nameInput = document.getElementById("exerciseName");
        const errorDiv = document.getElementById("createExerciseError");

        if (!nameInput.value.trim()) {
            errorDiv.textContent = "Exercise name is required.";
            errorDiv.style.display = "block";
            return;
        }

        errorDiv.style.display = "none";

        try {
            const response = await fetch("/Exercise/Create", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ Name: nameInput.value.trim() })
            });

            if (!response.ok) {
                const data = await response.json();
                errorDiv.textContent = data?.errors?.Name?.[0] || "Failed to create exercise.";
                errorDiv.style.display = "block";
                return;
            }

            // Success: reload page or append to table dynamically
            location.reload();
        } catch (err) {
            errorDiv.textContent = "Unexpected error occurred.";
            errorDiv.style.display = "block";
        }
    });
</script>

@* Edit, Save Button *@
<script>
    /* ==========================
       EDIT BUTTON
    ========================== */
    document.querySelectorAll(".edit-btn").forEach(btn => {
        btn.addEventListener("click", function () {
            const row = this.closest("tr");

            row.querySelectorAll(".enable-me").forEach(input => {
                input.disabled = false;
            });

            row.querySelector(".save-btn").style.display = "inline-block";
            this.style.display = "none";
        });
    });

    /* ==========================
       SAVE BUTTON
    ========================== */
    document.querySelectorAll(".save-btn").forEach(btn => {
        btn.addEventListener("click", async function () {
            const row = this.closest("tr");

            const payload = {
                exerciseID: row.querySelector('input[name="ExerciseID"]').value,
                name: row.querySelector('input[name="Name"]').value.trim()
            };

            if (!payload.name) {
                alert("Exercise name is required");
                return;
            }

            try {
                const response = await fetch("/Exercise/Update", {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (!response.ok) {
                    alert(data.message);
                    return;
                }
            
                console.log(data.message);

                // Lock inputs again
                row.querySelectorAll(".enable-me").forEach(input => {
                    input.disabled = true;
                });

                row.querySelector(".edit-btn").style.display = "inline-block";
                this.style.display = "none";

            } catch (err) {
                alert("Unexpected error");
            }
        });
    });
</script>

@* Single Delete *@
<script>
    let exerciseIdToDelete = null;

    document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", function () {
            exerciseIdToDelete = this.dataset.id;
            new bootstrap.Modal(
                document.getElementById("deleteExerciseModal")
            ).show();
        });
    });

    document.getElementById("confirmDeleteBtn").addEventListener("click", async function () {
        if (!exerciseIdToDelete) return;

        const response = await fetch(`/Exercise/Delete/${exerciseIdToDelete}`, {
            method: "DELETE"
        });
    
        const data = await response.text(); // or .json() if API returns JSON
    
        if (!response.ok) {
            alert("Failed to delete exercise");
            return;
        }
        alert(data);
        location.reload();
    });
</script>

