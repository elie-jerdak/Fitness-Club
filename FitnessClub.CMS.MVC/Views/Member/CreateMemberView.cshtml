@* Preview Image of profile after Selection *@
<script>
    function previewImage(event) {
        const fileInput = event.target;
        const file = fileInput.files[0];
        const preview = document.getElementById("imagePreview");

        if (file && file.type.startsWith("image/")) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = "block";
            };
            reader.readAsDataURL(file);
        } else {
            preview.src = "#";
            preview.style.display = "none";
        }
    }
</script>

@* JQuerry Scripts needed*@
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

@* QR Script*@
<script> 

    // Grab the token generated by Razor
    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    const Verificationtoken = tokenInput ? tokenInput.value : "";

    document.getElementById("generateQrBtn").addEventListener("click", function(e) {
    e.preventDefault();

    fetch('@Url.Action("GenerateFixedQr", "Qr")', {
        method: "POST",
        credentials: "include", // send auth cookie
        headers: {
            "RequestVerificationToken": Verificationtoken
        }
    })
    .then(res => {
    // Redirected to Login or Forbidden
    if (res.redirected) {
        window.location.href = res.url;
        return;
    }

    return res.json();
    })
    .then(data => {
        if (!data.success) {
            alert(data.message);
            return;
        }

        // Show QR
        const img = document.getElementById("qrImage");
        const placeholder = document.getElementById("qrPlaceholder");
        const QrCode = document.getElementById("QrCode");

        QrCode.value = data.qrToken
        img.src = data.qrCodeBase64; // or data.qrCodeUrl
        img.style.display = "block";

        placeholder.style.display = "none";
        });
    });
</script>

@* convertToBase64 Image *@
<script>
    let base64Image = null;
    let imageFileName = null;

    function convertToBase64(event) {
        try{

            const file = event.target.files[0];
            if (!file) {
                base64Image = null;
                imageFileName = null;
                return;
            }

            // CRITICAL: Check file size before converting
            const maxSize = 3 * 1024 * 1024;
            if (file.size > maxSize) {
                alert("Image must be 3 MB or smaller.");
                event.target.value = "";
                return;
            }

            // Extension check
            const allowedExtensions = ["jpg", "jpeg", "png"];
            const extension = file.name.split('.').pop().toLowerCase();

            if (!allowedExtensions.includes(extension)) {
                alert("Only JPG, JPEG, or PNG images are allowed.");
                event.target.value = "";
                return;
            }

            const reader = new FileReader();

            reader.onload = function(e) {
                base64Image = e.target.result.split(",")[1]; // Remove data prefix

                document.getElementById("ProfileImageBase64").value = base64Image;
                document.getElementById("ProfileImageFileName").value = file.name;

                 // Update preview
                const preview = document.getElementById("imagePreview");
                preview.src = URL.createObjectURL(file);
                preview.style.display = "block";
             };

            reader.readAsDataURL(file);
     } catch (err){
                console.log("Error resulting from convertToBase64 : ", err);
        }
     }

</script>

@* Sending Data to MVC *@
<script>
    document.getElementById("createMemberForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        try {
            const form = e.target;

            const dto = {
                user: {
                    First_Name: form.querySelector('[name="user.First_Name"]').value,
                    Last_Name: form.querySelector('[name="user.Last_Name"]').value,
                    Email: form.querySelector('[name="user.Email"]').value,
                    Password: form.querySelector('[name="user.Password"]').value,
                    Gender: form.querySelector('[name="user.Gender"]').value,
                    Address: form.querySelector('[name="user.Address"]').value,
                    Phone_Number: form.querySelector('[name="user.Phone_Number"]').value,
                    DOB: form.querySelector('[name="user.DOB"]').value,
                    Role: form.querySelector('[name="user.Role"]').value,
                    QrCode: form.querySelector('[name="user.QrCode"]').value
                },
                client: {
                    Height: form.querySelector('[name="client.Height"]').value,
                    Weight: form.querySelector('[name="client.Weight"]').value,
                    Target: form.querySelector('[name="client.Target"]').value,
                    MedicalHistory: form.querySelector('[name="client.MedicalHistory"]').value
                },
                membership: {
                    Type: form.querySelector('[name="membership.Type"]').value,
                    IsAutoRenewed: form.querySelector('[name="membership.IsAutoRenewed"]').checked
                },
                ProfileImageBase64: document.getElementById("ProfileImageBase64").value,
                ProfileImageFileName: document.getElementById("ProfileImageFileName").value
            };

            const response = await fetch(form.action, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken":
                        document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(dto)
            });

            if (response.ok) {
                window.location.href = "/Member/Index";
            } else {
                const error = await response.text();
                console.error("Create failed:", error);
                alert("Failed to create member.");
            }
        } catch (err) {
            console.error("Submit error:", err);
            alert("Unexpected error occurred.");
        }
    });
</script>


