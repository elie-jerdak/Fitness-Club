@using FitnessClub_Test.Dtos
@model MemberDetailViewDTO
@{

}
<head>
    <style>
        .image-wrapper {
            width: 100%;
            overflow: hidden;
        }

        .image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover; /*  fills perfectly, crops if needed */
            display: block;
        }

        th, td {
            text-align: center;
        }
    </style>
</head>
<main>
    <div class="container mt-4">
        <form id="editForm" asp-controller="Member" method="post" asp-action="EditPost">
            <input type="hidden" asp-for="@Model.Member.MemberID" name="MemberID" id="MemberID" value="@Model.Member.MemberID" />
            <input type="hidden" asp-for="@Model.Member.UserId" name="UserId" id="UserId" value="@Model.Member.UserId" />
            
            @* user part *@
            <div class="row mb-4">
                @* User Information *@
                <div class="col-md-8">
                    <div class="card">
                        <!--Begin.card-header-->
                        <div class="card-header">
                            <h3 class="card-title">User Information</h3>
                            <div class="card-tools">
                                <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                                    <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                    <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                                </button>
                            </div>
                        </div>

                        <!--Begin.card-body-->
                        <div class="card-body p-0">
                            <div class="col">
                                <div class="card-body p-4 text-black">

                                    <!-- First Name, Last_Name -->
                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <div class="form-outline">
                                                <label asp-for="@Model.Member.FirstName">First Name</label>
                                                <input asp-for="@Model.Member.FirstName" id="firstName" class="form-control" disabled/>
                                                <span asp-validation-for="@Model.Member.FirstName" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-4">
                                            <div class="form-outline">
                                                <label asp-for="@Model.Member.LastName">Last Name</label>
                                                <input asp-for="@Model.Member.LastName" id="lastName" class="form-control" disabled />
                                                <span asp-validation-for="@Model.Member.LastName" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Email, Address -->
                                    <div class="row">
                                        <div class="col-6 mb-4">
                                            <div class="form-outline">
                                                <label asp-for="@Model.Member.Email"></label>
                                                <input type="email" name="Email" asp-for="@Model.Member.Email" class="form-control" disabled />
                                                <span asp-validation-for="@Model.Member.Email" id="Email" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-4">
                                            <div class="form-outline">
                                                <label asp-for="@Model.Member.Role"></label>
                                                <select asp-for="@Model.Member.Role" id="role" asp-items="ViewBag.UserRole" class="form-control" disabled></select>
                                                <span asp-validation-for="@Model.Member.Role" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!--Gender, Address-->
                                    <div class="row">
                                        <div class="col-6 mb-4">
                                            <div class="form-outline">
                                                <label asp-for="@Model.Member.Gender"></label>
                                                <select asp-for="@Model.Member.Gender" id="gender" asp-items="ViewBag.GenderOptions" class="form-control" disabled>
                                                    <option value="">-- Select Gender --</option>
                                                </select>
                                                <span asp-validation-for="@Model.Member.Gender" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-4">
                                            <div class="form-outline">
                                                <label asp-for="@Model.Member.Address"></label>
                                                <input asp-for="@Model.Member.Address" name="Address" class="form-control" disabled />
                                                <span asp-validation-for="@Model.Member.Address" id="Address" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!--Phone_Number,Date_Of_Birth, Role-->
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="form-outline mb-4">
                                                <label asp-for="@Model.Member.PhoneNumber">Phone Number</label>
                                                <input type="tel" name="PhoneNumber" asp-for="@Model.Member.PhoneNumber" class="form-control" disabled />
                                                <span asp-validation-for="@Model.Member.PhoneNumber" id="PhoneNumber" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="form-outline mb-4">
                                                <label asp-for="@Model.Member.DOB">Date Of Birth</label>
                                                <input type="date" name="DOB" asp-for="@Model.Member.DOB" class="form-control" disabled />
                                                <span asp-validation-for="@Model.Member.DOB" id="DOB" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                
                @* Profile Image *@
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Profile Preview</h3>
                        </div>
                        <div class="card-body p-2">
                            <div class="image-wrapper">
                                <img id="imagePreview" src="@Url.Content($"~/assets/profileimages/{Model?.Member?.Photo ?? "default.png"}")" alt="Preview" 
                                style="width: 100%; height: 100%; object-fit: cover; display: block;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Client, Member part *@
            <div class="row mb-4">
                <div class="col-8">
                    @* Client Information *@
                    <div class="card mb-4">

                        <!--Begin.card-header-->
                        <div class="card-header">
                            <h3 class="card-title">Client Information</h3>
                            <div class="card-tools">
                                <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                                    <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                    <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                                </button>
                            </div>
                        </div>
                        
                        <!--Begin.card-body-->
                        <div class="card-body p-0">

                            <div class="col">
                                <div class="card-body p-4 text-black">

                                    <!-- Weight, Height -->
                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <div class="form-outline">
                                                <label asp-for="@Model.Member.Height"></label>
                                                <input asp-for="@Model.Member.Height" name="Height" class="form-control" disabled />
                                                <span asp-validation-for="@Model.Member.Height" id="Height" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-4">
                                            <div class="form-outline">
                                                <label asp-for="@Model.Member.Weight"></label>
                                                <input asp-for="@Model.Member.Weight" name="Weight" class="form-control" disabled />
                                                <span asp-validation-for="@Model.Member.Weight" id="Weight" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Target, MedicalHistory -->
                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <div class="form-outline">
                                                <label asp-for="@Model.Member.Target"></label>
                                                <select asp-for="@Model.Member.Target" id="Target" asp-items="ViewBag.ClientTarget" class="form-control" disabled>
                                                    <option value="">-- Select Target --</option>
                                                </select>
                                                <span asp-validation-for="@Model.Member.Target" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-4">
                                            <div class="form-outline">
                                                <label asp-for="@Model.Member.MedicalHistory"></label>
                                                <input asp-for="@Model.Member.MedicalHistory" id="MedicalHistory" class="form-control" disabled />
                                                <span asp-validation-for="@Model.Member.MedicalHistory" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                    
                    @* Membership Information *@
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Membership Information</h3>
                            <div class="card-tools">
                                <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                                    <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                    <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row ">
                                <div class="col-6">

                                    <div class="form-outline mb-4">
                                        <label asp-for="@Model.Member.IsAutoRenewed" class="form-check-label">Membership</label>
                                        @{
                                            if (Model.Member.IsAutoRenewed)
                                            {
                                                <input type="text" class="form-control" value="Auto-Renewed" disabled />
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" value="Not Auto-Renewed" disabled />
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-outline">
                                        <label asp-for="@Model.Member.Type"></label>
                                        <select asp-for="@Model.Member.Type" id="type" asp-items="ViewBag.MembershipType" class="form-control" disabled>
                                            <option value="">-- Select Type --</option>
                                        </select>
                                        <span asp-validation-for="@Model.Member.Type" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                @* QR Code *@
                <div class="col-4">
                        <div class="card">
                            <!--Begin.card-header-->
                            <div class="card-header">
                                <h3 class="card-title">QR Code</h3>
                                <div class="card-tools">
                                    <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                                        <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                                        <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                                    </button>
                                </div>
                            </div>
                            <!-- End.card-header -->
                            <!--Begin.card-body-->
                            <div class="card-body p-0">

                                <div class="col">
                                    <div class="card-body text-black">
                                        <div class="row">
                                            <div class="form-outline" style="display:flex; justify-content:center">
                                                <div id="qrDiv" style="width:100%; height:auto; border:1px solid black">
                                                    
                                                    <img id="qrImage" src="" alt="QR Code" style="width:100%; height:auto; display:none;" />
                                                    
                                                    <input type="hidden" id="QrCode" name="user.QrCode" value="@Model?.Member?.QrCode" />

                                                    <p id="qrPlaceholder" class="text-center">
                                                        No QR code generated yet.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                </div>
            </div>
            @* Programs Bought *@
            <div class="card mb-4">

                <!--Begin.card-header-->
                <div class="card-header">
                    <h3 class="card-title">Programs Bought</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                            <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                            <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                        </button>
                    </div>
                </div>
                <!-- End.card-header -->
                <!--Begin.card-body-->
                <div class="card-body p-0">

                    <div class="col">
                        <div class="card-body p-4 text-black">

                            <table class="table table-bordered table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Title</th>
                                        <th>Category</th>
                                        <th>Price</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.PurchasedPrograms != null && Model.PurchasedPrograms.Any())
                                    {
                                        foreach (var program in Model.PurchasedPrograms)
                                        {
                                            <tr>
                                                <td>@program.Title</td>
                                                <td>@program.Category</td>
                                                <td>@program.Price</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center">No programs have been purchased.</td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
                <!-- End.card-body -->
            </div>
            
            @* Private Sessions Booked *@
            <div class="card mb-4">

                <!--Begin.card-header-->
                <div class="card-header">
                    <h3 class="card-title">Private Sessions Booked</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                            <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                            <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                        </button>
                    </div>
                </div>
                <!-- End.card-header -->
                <!--Begin.card-body-->
                <div class="card-body p-0">

                    <div class="col">
                        <div class="card-body p-4 text-black">

                            <table class="table table-bordered table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Day</th>
                                        <th>Start Time</th>
                                        <th>End Time</th>
                                        <th>Coach</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.AvailabilitiesBooked != null && Model.AvailabilitiesBooked.Any())
                                    {
                                        foreach (var a in Model.AvailabilitiesBooked)
                                        {
                                            <tr>
                                                <td>@a.Day</td>
                                                <td>@a.StartTime</td>
                                                <td>@a.EndTime</td>
                                                <td>@a.CoachName</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center">No private sessions have been booked.</td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
                <!-- End.card-body -->
            </div>
            @* button *@
            <div class="row mt-4 d-flex justify-content-center">
                <a asp-action="Index" asp-controller="Member" class="btn btn-secondary w-25 mb-4">Back</a>
            </div>

        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            const UserID = @Model.Member.UserId;

            const response = await fetch(`/Member/GetQrByID?UserID=${UserID}`);
            const result = await response.json();

            if (!result.success)
                return;

            document.getElementById("qrImage").src = result.qrCodeBase64;
            document.getElementById("qrImage").style.display = "block";
            document.getElementById("qrPlaceholder").style.display = "none";
            document.getElementById("QrCode").value = result.token;
        });
    </script>
}