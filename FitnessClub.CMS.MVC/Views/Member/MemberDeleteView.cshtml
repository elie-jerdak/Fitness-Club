@using FitnessClub_Test.Dtos
@model MemberDTO
@{
}
<style>
    form div {
        margin-bottom: 1rem;
    }
</style>

<main>
    <div class="card mx-4 my-4">
        <div class="card-header">
            <h5 class="card-title">Delete Member</h5>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-lte-toggle="card-collapse">
                    <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                    <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                </button>
            </div>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
            <!--begin::Row-->
            <div class="row">
                <form asp-controller="Member" asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" asp-for="MemberID" />

                    <div class="form-group">
                        <label asp-for="First_Name">First Name</label>
                        <input asp-for="First_Name" class="form-control" value="@Model.First_Name" disabled />
                    </div>

                    <div class="form-group">
                        <label asp-for="Last_Name">Last Name</label>
                        <input asp-for="Last_Name" class="form-control" value="@Model.Last_Name" disabled />
                    </div>

                    <div class="form-group">
                        <label asp-for="StartDate">Start Date</label>
                        <input asp-for="StartDate" class="form-control" value="@Model.StartDate" disabled />
                    </div>

                    <div class="form-group">
                        <label asp-for="EndDate">End Date</label>
                        <input asp-for="EndDate" class="form-control" value="@Model.EndDate" disabled />
                    </div>

                    <div class="form-group">
                        <label asp-for="Type">Type</label>
                        <input asp-for="Type" class="form-control" value="@Model.Type" disabled />
                    </div>

                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-controller="Member" asp-action="Index" class="btn btn-secondary">Back To List</a>
                </form>
            </div>
            <!--end::Row-->
        </div>
        <!-- ./card-body -->
    </div>
</main>

