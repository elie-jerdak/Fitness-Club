@model IEnumerable<FitnessClub_Test.Dtos.MemberDTO>
@{

}
<head>
    <style>
        .card-custom {
            float: left;
            margin-left: 1.5rem;
        }

        .a-custom {
            max-width: fit-content;
            margin-left: 1rem;
            display: none;
        }

        .clickable-row:hover {
            background-color: #f1f1f1;
        }

    </style>
</head>
<!--begin::App Main-->
<main class="app-main">
    <div class="app-content">
        <!--begin::Container-->
        <div class="container-fluid">

            <!--begin: Row -->
            <div class="row mt-4">
                <div class="col-md-12">
                    <!--begin Member View-->
                    <div class="card mb-4">
                        <form asp-controller="Member" asp-action="BulkDelete" method="post">
                            <div class="card-header">
                            <div class="card-custom">
                                <div class="form-check d-flex">
                                    <input class="form-check-input mt-2" style="float:left" type="checkbox" id="checkAll">
                                    <a asp-controller="Member" asp-action="Create" class="btn btn-primary" style="margin-left:2rem;">Create</a>
                                    <button type="submit" class="btn btn-danger a-custom" id="delete-all-btn"><i class="bi bi-trash"></i> Delete</button>
                                </div>
                            </div>
                            <h5 class="card-title mt-2">Member List</h5>
                        </div>
                            <!-- /.card-header -->
                            <div class="card-body">
                            <!--begin::Row-->
                            <div class="row">
                                <div class="table-responsive">
                                    <table class="table m-0">
                                        <thead>
                                            <tr>
                                                <th style="width:5%"></th>
                                                <th>User Id</th>
                                                <th>Member Id</th>
                                                <th>First Name</th>
                                                <th>Last Name</th>
                                                <th>Start Date</th>
                                                <th>End Date</th>
                                                <th>Type</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td><input type="checkbox" name="selectedMemberIDs" value="@item.MemberID" class="form-check-input item-checkbox" style="margin-left:1rem" /></td>
                                                    <td class="clickable-row" data-href="@Url.Action("Details", "Member", new { userId = item.UserID })" style="cursor:pointer;">@item.UserID</td>
                                                    <td class="clickable-row" data-href="@Url.Action("Details", "Member", new { userId = item.UserID })" style="cursor:pointer;">@item.MemberID</td>
                                                    <td class="clickable-row" data-href="@Url.Action("Details", "Member", new { userId = item.UserID })" style="cursor:pointer;">@item.First_Name</td>
                                                    <td class="clickable-row" data-href="@Url.Action("Details", "Member", new { userId = item.UserID })" style="cursor:pointer;">@item.Last_Name</td>
                                                    <td class="clickable-row" data-href="@Url.Action("Details", "Member", new { userId = item.UserID })" style="cursor:pointer;">@item.StartDate.ToShortDateString()</td>
                                                    <td>@item.EndDate</td>
                                                    <td>@item.Type</td>
                                                    <td>
                                                        <div class="w-100 btn-group" role="group">
                                                            <a asp-controller="Member" asp-action="Edit" asp-route-memberId="@item.MemberID"
                                                               class="btn btn-primary mx-2"><i class="bi bi-pencil-square"></i> Edit</a>
                                                            <a asp-controller="Member" asp-action="Delete" asp-route-MemberID="@item.MemberID"
                                                               class="btn btn-danger mx-2"><i class="bi bi-trash"></i> Cancel Membership</a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <!-- /.table-responsive -->
                                
                            </div>
                            <!--end::Row-->
                        </div>
                            <!-- ./card-body -->
                        </form>
                    </div>
                    <!-- end Member View -->
                </div>
            </div>
            <!--end:: Row -->
        </div>
        <!--end::Container-->
    </div>
    <!--end::App Content-->
</main>
<!--end::App Main-->
<script>
    const checkAll = document.getElementById('checkAll');
    const checkboxes = document.querySelectorAll('.item-checkbox');
    const deleteButton = document.getElementById('delete-all-btn');

    function updateRowHighlight(checkbox) {
      const row = checkbox.closest('tr');
      row.classList.toggle('table-active', checkbox.checked);
    }

    function updateDeleteButton() {
      const checkedCount = document.querySelectorAll('.item-checkbox:checked').length;
      deleteButton.style.display = checkedCount >= 2 ? 'inline-block' : 'none';
    }

    // Handle individual checkbox changes
    checkboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        updateRowHighlight(cb);

        // Update "Check All" state
        const allChecked = [...checkboxes].every(c => c.checked);
        checkAll.checked = allChecked;

        updateDeleteButton();
      });
    });

    // Handle "Check All" checkbox
    checkAll?.addEventListener('change', function () {
      const isChecked = this.checked;
      checkboxes.forEach(cb => {
        cb.checked = isChecked;
        updateRowHighlight(cb);
      });
      updateDeleteButton();
    });

    document.querySelectorAll(".clickable-row").forEach(row => {
        row.addEventListener("click", function () {
            const href = this.getAttribute("data-href");
            if (href) {
                window.location.href = href;
            }
        });
    });
</script>
