</head>
<body class="layout-fixed sidebar-expand-lg sidebar-mini bg-body-tertiary">
    <div class="app-wrapper">
        
        <!--begin::Header-->
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <div id="dateTimeDisplay" class="text-muted w-100" style="text-align:center"></div>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown user-menu">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            <img src="@Url.Content($"~/assets/profileimages/{user.Photo ?? "default.png"}")"
                                 class="user-image rounded-circle shadow"
                                 alt="User Image" />
                            <span class="d-none d-md-inline">@user.FirstName @user.LastName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-lg">
                            <li class="user-header text-bg-primary">
                                <img src="@Url.Content($"~/assets/profileimages/{user.Photo ?? "default.png"}")" class="rounded-circle shadow" alt="User Image" />
                                <p>
                                    @user.FirstName @user.LastName
                                    <small>Member since @user.MemberSince</small>
                                </p>
                            </li>
                            <li class="user-footer">
                                <a asp-controller="AdminAccount" asp-action="Index" class="btn btn-default btn-flat">Profile</a>
                                <a asp-controller="Login" asp-action="Logout" class="btn btn-default btn-flat float-end">Sign out</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>
        
        <!--begin::Sidebar-->
        <aside class="app-sidebar bg-primary-subtle shadow" data-bs-theme="light">
            <div class="sidebar-brand">
