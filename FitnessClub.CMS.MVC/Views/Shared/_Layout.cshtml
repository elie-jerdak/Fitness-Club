                    <span class="brand-text fw-light">Fitness Club</span>
                </a>
            </div>
            <!--begin::Sidebar Wrapper-->
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <!--begin::Sidebar Menu-->
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
                        <!--Dashbord List Item-->
                        <li class="nav-item">
                            <a asp-controller="Dashboard" asp-action="Index" class="nav-link">
                                <i class="bi bi-speedometer"></i>
                                <p>
                                    Dashboard
                                </p>
                            </a>
                        </li>
                        
                        <!--Account-->
                        <li class="nav-item">
                            <a asp-controller="AdminAccount" asp-action="Index" class="nav-link">
                                <i class="bi bi-person-lines-fill"></i>
                                <p>Account</p>
                            </a>
                        </li>
                        <!--Members & Subscriptions-->
                        <li class="nav-header">MEMBERS & SUBSCRIPTIONS</li>
                        <li class="nav-item">
                            <a asp-controller="Member" asp-action="Index" class="nav-link">
                                <i class="bi bi-people-fill"></i>
                                <p>Members</p>
                            </a>
                        </li>
                        <!--Subscription and Payments-->
                        <li class="nav-item">
                            <a asp-controller ="UpcomingExpiration" asp-action="UpcomingExpirations" class="nav-link">
                                <i class="bi bi-credit-card-2-back-fill"></i>
                                <p>Subscriptions & Payments</p>
                            </a>
                        </li>
                        
                        <!--Coaching and Training-->
                        <li class="nav-header">COACHING & TRAINING</li>
                        <li class="nav-item">
                            <a asp-controller="Coach" asp-action="Index" class="nav-link">
                                <i class="bi bi-person-badge-fill"></i>
                                <p>Coaches</p>
                            </a>
                        </li>
                        <!--Traing Programs-->
                        <li class="nav-item">
                            <a asp-controller="PremadePrograms" asp-action="Index" class="nav-link">
                                <i class="bi bi-patch-check-fill"></i>
                                <p>Training Programs</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Exercise" asp-action="Index" class="nav-link d-flex align-items-center">
