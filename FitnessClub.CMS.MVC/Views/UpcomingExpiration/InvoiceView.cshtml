@using FitnessClub_Test.Dtos
@model InvoiceDTO
@{
    Layout = null;

    decimal unitPrice = 0;
    int Month = 1;

    switch (@Model.member.Type)
    {
        case "Trial":
            Month = 7;
            unitPrice = 14.99m;

            break;
        case "Monthly":
            unitPrice = 29.99m;
            break;
        case "Yearly":
            Month = 12;
            unitPrice = 27m;
            break;
        default:
            unitPrice = 0;
            break;
    }
    
    var subtotal = Month * unitPrice;
    var tax = subtotal * 0.05m; // Example: 5%
    var total = subtotal + tax;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/Invoice.css" />

</head>
<body class="p-4">
    <div class="text-end mt-4 mb-4 no-print">
        <button onclick="window.print()" class="btn btn-outline-secondary me-2">
            <i class="bi bi-printer"></i> Print Invoice
        </button>
        <a asp-controller="InvoicePDFGenerate" asp-action="DownloadPdf" asp-route-id="@Model.InvoiceID" class="btn btn-outline-success">
            <i class="bi bi-download"></i> Download PDF
        </a>
        <a asp-controller="UpcomingExpiration" asp-action="UpcomingExpirations" class="btn btn-outline-info">Go Back</a>
    </div>
    
    <div class="container">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h2 class="invoice-header">FitnessClub</h2>
                <p>Keeping you fit!</p>
                <p>
                    S & S Center, Jisr El Bacha Street, 5th Floor | P.O Box: 45-462 Hazmieh – Lebanon<br />
                    T: +961 5 451 450  ext. 108  |  M: +961 71 229 616<br />
                    sami.assaf@mt2morrow.com
                </p>
                <p>
                    <strong>To:</strong><br />
                    @Model.User.First_Name @Model.User.Last_Name<br />
                    @Model.User.Address<br />
                    @Model.User.Phone_Number<br />
                    Customer ID No. @Model.User.Id
                </p>
            </div>

            <div class="text-end">
                <h4 class="invoice-header">INVOICE</h4>
                <p><strong>Invoice #:</strong> @Model.InvoiceID</p>
                <p><strong>Date:</strong> @Model.Date.ToShortDateString()</p>
                <p><strong>Term:</strong> @Model.member.StartDate.ToShortDateString() to @Model.member.EndDate.ToShortDateString()</p>
                <p><strong>Payment Method:</strong>@Model.PaymentMethod</p>
                <p><strong>Currency:</strong>@Model.Currency</p>
            </div>
        </div>

        <div class="mt-4">
            <table class="table invoice-table" style="table-layout: fixed;">
                <thead>
                    <tr>
                        <th style="width: 40%;">Description</th>
                        <th style="width: 20%;">Months</th>
                        <th style="width: 20%;">Unit Price</th>
                        <th style="width: 20%;">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.member.Type Membership</td>
                        <td>
                            @(Model.member.Type == "Trial" ? $"{Month} days" : Month.ToString())
                        </td>

                        <td>$@unitPrice</td>
                        <td>$@subtotal</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end fw-bold no-left-bottom-border">Subtotal</td>
                        <td>$@subtotal</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end fw-bold no-left-bottom-top-border">Tax (5%)</td>
                        <td>$@tax</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end fw-bold no-left-bottom-top-border">Total</td>
                        <td><strong style="color: forestgreen;">$@total</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="invoice-footer mt-4">
            <p><strong>Invoice prepared by:</strong>Elie Jerdak</p>
            <p>
                This is an invoice on the fitness training costs, subject to the conditions noted below:
                <br /><em>All sales final, payment due upon receipt.</em>
            </p>
            <p>
                To accept this invoice, sign here and return:
                <span style="border-bottom: 1px solid black; padding-left: 100px; margin-left: 10px;"></span>
            </p>
            <p class="fw-bold text-success mt-4">Thank you for your business!</p>
        </div>
    </div>
    
</body>
</html>
