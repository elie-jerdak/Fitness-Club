@model UpdateProfileViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Update Profile";
}
<main>
    <!-- Hero Start -->
    <div class="slider-area2">
        <div class="slider-height2 d-flex align-items-center">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="hero-cap hero-cap2 pt-70">
                            <h2>@ViewData["Title"]</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Hero End -->

    <div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center">
        <div class="card user-card-full shadow w-100" style="max-width: 900px; margin-top: 4%;">
            <div class="row g-0">
                <div class="col-sm-4 bg-c-lite-green user-profile">
                    <div class="card-body text-center text-white">
                        <div class="mb-3">
                            <img src="https://www.gravatar.com/avatar/?d=mp&s=200" class="img-radius img-fluid"
                                alt="User-Profile-Image">
                        </div>
                        <h2 style="color: white;">@Model.FirstName @Model.SecondName</h2>
                        <h4 style="color: white;">@Model.Role</h4>
                    </div>
                </div>
                <div class="col-sm-8">
                    <div class="card-body" style="margin-top: 3%; margin-bottom: 3%;">
                        <form asp-action="UpdateProfile" method="post">

                            @if (Model.Role == "Client")
                            {
                                <div class="mb-3">
                                    <label asp-for="Weight" class="fw-bold mb-1"></label>
                                    <input asp-for="Weight" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Height" class="fw-bold mb-1"></label>
                                    <input asp-for="Height" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="MedicalIssues" class="fw-bold mb-1"></label>
                                    <input asp-for="MedicalIssues" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Target" class="fw-bold mb-1"></label>
                                    <input asp-for="Target" class="form-control" />
                                </div>
                            }
                            else if (Model.Role == "Coach")
                            {
                                <div class="mb-3">
                                    <label asp-for="Salary" class="fw-bold mb-1"></label>
                                    <input asp-for="Salary" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Experience" class="fw-bold mb-1"></label>
                                    <input asp-for="Experience" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Specialty" class="fw-bold mb-1"></label>
                                    <input asp-for="Specialty" class="form-control" />
                                </div>
                            }

                            <button type="submit" class="btn btn-primary">Confirm Update</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Services Area -->
    <section class="services-area">
        <div class="container">
            <div class="row justify-content-between">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-8">
                    <div class="single-services mb-40 wow fadeInUp" data-wow-duration="1s" data-wow-delay=".1s">
                        <div class="features-icon">
                            <img src="~/lib/img/icon/icon1.svg" alt="">
                        </div>
                        <div class="features-caption">
                            <h3>Location</h3>
                            <p>Still loading</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-8">
                    <div class="single-services mb-40 wow fadeInUp" data-wow-duration="1s" data-wow-delay=".2s">
                        <div class="features-icon">
                            <img src="~/lib/img/icon/icon2.svg" alt="">
                        </div>
                        <div class="features-caption">
                            <h3>Phone</h3>
                            <p>+961 81 123 456</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-8">
                    <div class="single-services mb-40 wow fadeInUp" data-wow-duration="2s" data-wow-delay=".4s">
                        <div class="features-icon">
                            <img src="~/lib/img/icon/icon3.svg" alt="">
                        </div>
                        <div class="features-caption">
                            <h3>Email</h3>
                            <p>fitnessclub@gmail.com</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>