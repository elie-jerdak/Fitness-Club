@model YourProjectNamespace.Models.ContactViewModel
@{
    ViewData["Title"] = "Contact";
    Layout = "_Layout";
}

<main>
    <!--? Hero Start -->
    <div class="slider-area2">
        <div class="slider-height2 d-flex align-items-center">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="hero-cap hero-cap2 pt-70">
                            <h2>Contact Me</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Hero End -->

    <!--? Contact Area start -->
    <section class="contact-section">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h2 class="contact-title" style="margin-bottom: 3%; color: white;">Get in Touch</h2>
                </div>
                <div class="col-lg-8" >

                    <form id="contactForm" class="form-contact contact_form" novalidate>
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group" style="margin-top: 3%;">
                                    <textarea id="message" class="form-control" rows="5" placeholder="Enter message"></textarea>
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <input id="name" class="form-control" placeholder="Enter your name" />
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <input id="email" class="form-control" placeholder="Enter email" />
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <input id="subject" class="form-control" placeholder="Enter subject" />
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="form-group">
                                    <select id="type" class="form-control">
                                        <option value="">Select type</option>
                                        <option value="Question">Question</option>
                                        <option value="Feedback">Feedback</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mt-3">
                            <button type="button" class="button button-contactForm boxed-btn" onclick="sendMessage()">Send</button>
                            <button type="button" class="button button-contactForm boxed-btn ml-3" onclick="loadMessageHistory(this)">View History</button>
                        </div>
                        <div id="messageHistory" class="mt-5" style="display: none;">
                            <h4 style="color: black; margin-bottom: 30px;">Your Previous Messages:</h4>
                            <div class="filter-wrapper">
                                <label for="filterType" class="filter-label">Filter by type:</label>
                                <select id="filterType" class="filter-select" onchange="renderMessages()">
                                    <option value="">All</option>
                                    <option value="Question">Question</option>
                                    <option value="Feedback">Feedback</option>
                                </select>
                            </div>
                            <div id="messageList" style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center;"></div>
                            <div style="text-align: center; margin-bottom: 20px;">
                                <button class="button button-contactForm boxed-btn" onclick="exportToCSV()">Export to CSV</button>
                                <button class="button button-contactForm boxed-btn ml-2" onclick="exportToPDF()">Export to PDF</button>
                            </div>
                            <div id="paginationControls" style="text-align: center; margin-top: 20px;"></div>
                        </div>
                        <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
                        <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
                    </form>
                </div>

                <div class="col-lg-3 offset-lg-1">
                    <div class="media contact-info" style="margin-top: 5%;">
                        <span class="contact-info__icon"><i class="ti-home"></i></span>
                        <div class="media-body">
                            <h3>Lebanon, Beirut.</h3>
                            <p>Hazmieh</p>
                        </div>
                    </div>
                    <div class="media contact-info">
                        <span class="contact-info__icon"><i class="ti-tablet"></i></span>
                        <div class="media-body">
                            <h3>+961 81 123 456</h3>
                            <p>Mon to Fri 9am to 6pm</p>
                        </div>
                    </div>
                    <div class="media contact-info">
                        <span class="contact-info__icon"><i class="ti-email"></i></span>
                        <div class="media-body">
                            <h3>fitnessclub@gmail.com</h3>
                            <p>Send us your query anytime!</p>
                        </div>
                    </div>
                </div>
                <script src="~/js/site.js"></script>
            </div>
        </div>
    </section>
    <!-- Contact Area End -->

    <!--? Services Area -->
    <section class="services-area">
        <div class="container">
            <div class="row justify-content-between">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-8">
                    <div class="single-services mb-40 wow fadeInUp" data-wow-duration="1s" data-wow-delay=".1s">
                        <div class="features-caption">
                            <h3>Location</h3>
                            <p>Still loading</p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-8">
                    <div class="single-services mb-40 wow fadeInUp" data-wow-duration="1s" data-wow-delay=".2s">
                        <div class="features-caption">
                            <h3>Phone</h3>
                            <a href="tel:+96181123456">+961 81 123 456</a>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-8">
                    <div class="single-services mb-40 wow fadeInUp" data-wow-duration="2s" data-wow-delay=".4s">
                        <div class="features-caption">
                            <h3>Email</h3>
                            <a href="mailto:fitnessclub@gmail.com">fitnessclub@gmail.com</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
