@{
    ViewData["Title"] = "Subscription";
    Layout = "_Layout";
}

<main>
    <!-- Hero -->
    <div class="slider-area2">
        <div class="slider-height2 d-flex align-items-center">
            <div class="container">
                <div class="row">
                    <div class="col-xl-12 text-center">
                        <div class="hero-cap hero-cap2 pt-70">
                            <h2>Choose Your Plan</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container text-center mb-4">
        <p style="font-size: 1.5rem; font-family: 'Poppins', sans-serif; color: #ffffff;">
            Flexible plans to help you achieve your fitness goals
        </p>
    </div>

    <!-- Pricing Section (with relevant icons and containers) -->
    <section class="pricing-area section-padding40 black-bg">
        <div class="container">
            <div class="row justify-content-center">
                <!-- Free Trial -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="bg-white text-dark p-4 rounded-3 shadow text-center h-100 border border-2 border-white border-opacity-25">
                        <div class="mb-3">
                            <i class="fas fa-gift fa-3x text-danger"></i>
                        </div>
                        <h4>Free Trial</h4>
                        <p class="text-danger fw-bold mb-2">$0 / 7 days</p>
                        <p class="mb-3">Try 3 classes with limited access and no commitment.</p>
                        <a href="#" class="btn">Start Free Trial</a>
                    </div>
                </div>

                <!-- Monthly -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="bg-white text-dark p-4 rounded-3 shadow text-center h-100 border border-2 border-white border-opacity-25">
                        <div class="mb-3">
                            <i class="fas fa-calendar-alt fa-3x text-danger"></i>
                        </div>
                        <h4>Monthly</h4>
                        <p class="text-danger fw-bold mb-2">$29 / month</p>
                        <p class="mb-3">Unlimited classes, full access, cancel anytime.</p>
                        <a href="#" class="btn">Subscribe Monthly</a>
                    </div>
                </div>

                <!-- Annual -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="bg-white text-dark p-4 rounded-3 shadow text-center h-100 border border-2 border-white border-opacity-25">
                        <div class="mb-3">
                            <i class="fas fa-crown fa-3x text-danger"></i>
                        </div>
                        <h4>Annual</h4>
                        <p class="text-danger fw-bold mb-2">$299 / year</p>
                        <p class="mb-3">2 free sessions, priority booking, save $49.</p>
                        <a href="#" class="btn">Go Annual</a>
                    </div>
                </div>
            </div>
        </div>
    </section>





    <!-- Optional: Comparison Table -->
    <!-- Add if you want a feature matrix comparing plans -->
</main>
